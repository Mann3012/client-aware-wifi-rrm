# =============================================================================
# Python Artifacts
# Compiled bytecode, optimized files, and C extension modules generated by the
# Python interpreter. These are machine-specific and regenerated on import.
# =============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd

# =============================================================================
# Virtual Environments
# Local dependency installations. Each developer creates their own; committing
# these would bloat the repo with hundreds of MB of platform-specific binaries.
# =============================================================================
venv/
.venv/
env/

# =============================================================================
# Local Databases
# SQLite database files generated at runtime by SQLAlchemy (connection.py).
# The schema is auto-created on startup via init_db(), so these are ephemeral.
# Includes the main DB (rrm_database.db) and any backup copies.
# =============================================================================
*.db
*.sqlite
*.sqlite3

# =============================================================================
# Environment Configuration
# .env files contain local secrets and tuning parameters (API ports, simulator
# speed, EWMA/CUSUM thresholds). Each developer configures their own from the
# committed .env.example template.
# =============================================================================
.env
.env.*
!.env.example

# =============================================================================
# IDE / Editor Configuration
# Developer-specific workspace settings, font preferences, debug configs, etc.
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# OS-Generated Files
# Thumbnail caches and metadata files created by Windows Explorer and macOS
# Finder. Never relevant to source control.
# =============================================================================
Thumbs.db
Desktop.ini
.DS_Store

# =============================================================================
# Logs
# Runtime log files from uvicorn, FastAPI, or any configured Python logger.
# =============================================================================
*.log

# =============================================================================
# Streamlit Artifacts
# Streamlit generates secrets and cache files on first run. We ignore only
# secrets (contains credentials) but keep config.toml trackable for themes.
# =============================================================================
.streamlit/secrets.toml

# =============================================================================
# Python Testing & Coverage Artifacts
# Generated by pytest, unittest, coverage.py, and tox during test runs.
# =============================================================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# =============================================================================
# Python Build & Distribution Artifacts
# Generated by setuptools, pip, or wheel during packaging. Not relevant for
# this project's current state but included proactively.
# =============================================================================
*.egg-info/
*.egg
dist/
build/

# =============================================================================
# Generated CSV / Telemetry Output Files
# The legacy standalone simulator (telemetry_simulator.py) writes historical
# telemetry to CSV files. Only ignore known generated files so that future
# intentional CSVs (sample_dataset.csv, training data, etc.) remain trackable.
# =============================================================================
telemetry_output.csv
temp_telemetry_test.csv

# =============================================================================
# Jupyter Notebook Checkpoints
# Auto-saved checkpoint files if notebooks are used for experimentation.
# =============================================================================
.ipynb_checkpoints/

# =============================================================================
# mypy / type-checking caches
# =============================================================================
.mypy_cache/

# =============================================================================
# Python Version Managers
# Files created by pyenv, asdf, etc. to pin a local Python version.
# =============================================================================
.python-version

# =============================================================================
# Local Cache
# General-purpose cache directories created by various tools.
# =============================================================================
.cache/

# =============================================================================
# Runtime Files
# PID files written by background processes (uvicorn, gunicorn, etc.).
# =============================================================================
*.pid
