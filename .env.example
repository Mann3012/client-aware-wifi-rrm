# Database Settings
# For PostgreSQL: postgresql://username:password@localhost:5432/rrm_db
# Leave empty to automatically fallback to local SQLite (rrm_database.db)
DATABASE_URL=

# Simulator Configurations
SIMULATOR_INTERVAL_SECONDS=60
SIMULATOR_SPEED_MULTIPLIER=1.0
NUMBER_OF_APS=3
SEED_HISTORICAL_DATA=true
SEED_HOURS=6

# Change Detection Parameters
EWMA_SPAN=10
EWMA_THRESHOLD_STDEVS=3.0
CUSUM_THRESHOLD=5.0
CUSUM_DRIFT=0.5

# RRM Policy Thresholds
HIGH_RETRY_RATE_THRESHOLD=0.15          # 15% retry rate indicates high congestion/packet loss
HIGH_AIRTIME_UTILIZATION_THRESHOLD=0.70  # 70% channel occupancy indicates high load
LOW_RSSI_THRESHOLD=-75                  # RSSI <= -75 dBm is considered weak coverage
LOW_SNR_THRESHOLD=15                    # SNR <= 15 dB is considered noisy/poor quality
HIGH_NOISE_FLOOR_THRESHOLD=-85          # Noise floor >= -85 dBm indicates high interference

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
